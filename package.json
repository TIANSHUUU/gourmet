{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "notes:dev": "wrangler dev --config notes-app/wrangler.jsonc",
    "notes:deploy": "wrangler deploy --config notes-app/wrangler.jsonc",
    "notes:pull": "node scripts/notes-pull.mjs",
    "coords:backfill": "node scripts/backfill-coords.mjs",
    "coords:check": "node scripts/backfill-coords.mjs --check",
    "maps": "node scripts/build-map-style.mjs",
    "maps:worker": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maps/maplibre-gl-worker.js')\"",
    "map:assets": "node scripts/ingest-map-assets.mjs",
    "takeout:import": "node scripts/import-takeout.mjs",
    "photos:import": "node scripts/import-photos.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "maplibre-gl": "^6.18.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "wrangler": "^4.120.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  }
}
